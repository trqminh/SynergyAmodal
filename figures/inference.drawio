        <mxCell id="cell-90" parent="1" vertex="1" value="Three branches: image + text  /  image + empty text  /  zero image condition + empty text. If both scales = 1, use one conditional prediction." style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=22;fontColor=#171717;align=center;verticalAlign=middle;spacing=3;text;fillColor=none;strokeColor=none;fontSize=21;fontStyle=0;fontColor=#171717;align=center;fontFamily=Arial;">
