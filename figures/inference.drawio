        <mxCell id="cell-89" parent="1" vertex="1" value="ε̂ = ε∅ + simage (εimage − ε∅) + stext (εimage,text − εimage)" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=22;fontColor=#171717;align=center;verticalAlign=middle;spacing=3;text;fillColor=none;strokeColor=none;fontSize=28;fontStyle=0;fontColor=#171717;align=center;fontFamily=Times New Roman;">
